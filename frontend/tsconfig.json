{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Vite / bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Fase 3 vai ligar "strict" progressivamente — src/ já é 100% .ts/.tsx,
       então allowJs/checkJs saíram (não há mais .js/.jsx para permitir). */
    "strict": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,

    /* Alias — espelha o jsconfig.json atual */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
