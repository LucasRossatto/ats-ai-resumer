    {
      "name": "Resumes",
      "item": [
        {
          "name": "Create Resume (upload PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const data = body.data || {};",
                  "if (data.resume && data.resume.id) {",
                  "    pm.environment.set('resumeId', data.resume.id);",
                  "}",
                  "if (data.version && data.version.id) {",
                  "    pm.environment.set('versionId', data.version.id);",
                  "}",
                  "pm.test('resume criado com a V1', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(data).to.have.property('resume');",
                  "    pm.expect(data).to.have.property('version');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "PDF, no maximo 5MB"
                },
                {
                  "key": "title",
                  "value": "Meu curriculo",
                  "type": "text",
                  "description": "Opcional, no maximo 120 caracteres. Sem titulo usa o nome do arquivo."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/resumes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "resumes"]
            },
            "description": "Rate limit: 10 req/min. Extrai o texto do PDF e cria a versao V1.\n\nErros: 400 sem arquivo ou nao PDF, 413 acima de 5MB, 422 PDF corrompido.\n\nSelecione o arquivo na aba Body > form-data antes de enviar."
          },
          "response": []
        },
