{
  "info": {
    "_postman_id": "6d649d84-02ef-42e6-95b7-b4732d194e50",
    "name": "ATS AI Resumer API",
    "description": "Colecao da API do backend (NestJS, Clean Architecture + DDD).\n\nPrefixo global: /api, versionamento por URI (v1). A rota /health fica fora do prefixo.\n\nUse o environment `ATS AI Resumer - Local`. Register, Login e Refresh Token salvam accessToken e refreshToken automaticamente; Create Resume salva resumeId e versionId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "40738531"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const data = body.data || {};",
                  "if (data.access_token) {",
                  "    pm.environment.set('accessToken', data.access_token);",
                  "    pm.environment.set('refreshToken', data.refresh_token);",
                  "    pm.environment.set('authId', data.authId);",
                  "    pm.environment.set('profileId', data.profileId);",
                  "}",
                  "pm.test('registrou e retornou tokens', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(data).to.have.property('access_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John\",\n    \"lastname\": \"Doe\",\n    \"age\": 30,\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Rate limit: 5 req/min. Cria auth + profile via saga e ja devolve os tokens."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
