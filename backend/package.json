{
  "name": "destrava-curriculo",
  "version": "0.0.1",
  "description": "",
  "author": "Lucas Rossatto",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "concurrently --handle-input \"wait-on dist/main.js && nodemon\" \"tsc -w -p tsconfig.build.json\" ",
    "start:debug": "nodemon --config nodemon-debug.json",
    "prestart:prod": "rimraf dist && pnpm run build",
    "start:prod": "node dist/main.js",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:logs": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml logs -f api",
    "docker:start": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml start",
    "docker:stop": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml stop",
    "docker:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down -v",
    "docker:restart": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down && docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage ",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "eval": "ts-node scripts/eval-analysis.ts"
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@google/genai": "^2.32.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "module-alias": "^2.3.5",
    "mongoose": "^8.24.8",
    "ms": "^2.1.3",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^9.5.1"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/../test/setup-unit-env.ts"
    ],
    "coveragePathIgnorePatterns": [
      "(.dto)\\.(ts|tsx|js)$",
      "(.interceptor)\\.(ts|tsx|js)$"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../scripts"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(uuid|@faker-js\\+faker)@)"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@application(.*)$": "<rootDir>/application$1",
      "@domain(.*)$": "<rootDir>/domain$1",
      "@infrastructure(.*)$": "<rootDir>/infrastructure$1",
      "@api(.*)$": "<rootDir>/api$1",
      "@constants(.*)$": "<rootDir>/constants$1"
    }
  },
  "_moduleAliases": {
    "@root": ".",
    "@domain": "dist/domain/*",
    "@constants": "dist/constants",
    "@application": "dist/application/*",
    "@infrastructure": "dist/infrastructure/*",
    "@api": "dist/api/*"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "unrs-resolver"
    ]
  }
}
